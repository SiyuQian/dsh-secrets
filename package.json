{
  "name": "dsh-secrets",
  "version": "0.1.0",
  "description": "Securely collect credentials from the user into 0600 dotenv files without exposing values to the model, with read guards, output redaction, and exfiltration approval.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "skills",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs/api-findings*.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiyuQian/dsh-secrets.git"
  },
  "bugs": {
    "url": "https://github.com/SiyuQian/dsh-secrets/issues"
  },
  "homepage": "https://github.com/SiyuQian/dsh-secrets#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "secrets",
    "credentials",
    "dotenv",
    "llm-security"
  ],
  "author": "Siyu Qian",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
